APP_NAME=Healthcare Agentic AI Evidence Assistant
API_HOST=127.0.0.1
API_PORT=8000
HEALTHCARE_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=*
TOP_K=5
SPARSE_WEIGHT=0.35
DENSE_WEIGHT=0.65
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
MAX_WORKFLOW_STEPS=8
LOG_LEVEL=INFO

# GroqCloud LLM Integration Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
